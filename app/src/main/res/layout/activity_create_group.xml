<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A2E">

    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:background="#8A2BE2" android:gravity="center_vertical" android:padding="10dp">
        <ImageButton android:id="@+id/backBtn" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/back" android:background="#8A2BE2" android:scaleType="centerInside"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New Group" android:textSize="20sp" android:textColor="#FFFFFF"/>
    </LinearLayout>

    <EditText android:id="@+id/groupTitle" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Group name" android:textColor="#1A1A2E" android:background="#FFFFFF" android:padding="12dp" android:layout_margin="12dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select members:" android:textColor="#FFFFFF" android:textSize="14sp" android:paddingStart="12dp" android:paddingBottom="8dp"/>

    <ListView android:id="@+id/membersList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#333" android:dividerHeight="1dp"/>

    <Button android:id="@+id/createBtn" android:layout_width="match_parent" android:layout_height="50dp" android:text="Create Group" android:textColor="#FFFFFF" android:backgroundTint="#8A2BE2" android:layout_margin="12dp"/>

</LinearLayout>
